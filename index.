$('btn-add-examen').onclick = ()=>addExamen();

// Egreso
document.querySelectorAll('input[name="egresoTipo"]').forEach(r=>{
    r.addEventListener('change', ()=>{
        $('egreso-alta').classList.toggle('hidden', r.value!=='alta');
        $('egreso-traslado').classList.toggle('hidden', r.value!=='traslado');
        $('egreso-fallecido').classList.toggle('hidden', r.value!=='fallecido');
