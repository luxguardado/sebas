    if(e.target.value==='Hombre'){
        btnGuardar.className = 'px-8 py-3.5 rounded-2xl font-semibold transition-all shadow-lg shadow-blue-900/30 bg-[#3B82F6] hover:bg-blue-500 text-white';
        btnGuardar.innerHTML = '👦 Guardar';
    } else if(e.target.value==='Mujer'){
        btnGuardar.className = 'px-8 py-3.5 rounded-2xl font-semibold transition-all shadow-lg shadow-pink-900/30 bg-[#EC4899] hover:bg-pink-500 text-white';
        btnGuardar.innerHTML = '👧 Guardar';
    } else {
        btnGuardar.className = 'px-8 py-3.5 rounded-2xl font-semibold bg-gray-700 text-gray-300';
        btnGuardar.innerHTML = 'Guardar';
    }
});

// Seguimiento diario
function addDia(data={}){
    const tr = document.createElement('tr'); tr.className='hover:bg-[#111]';
    const today = new Date().toISOString().split('T')[0];
    tr.innerHTML = `
        <td class="p-1"><input type="date" value="${data.fecha||today}" class="input w-full rounded px-2 py-1.5 text-xs"></td>
        <td class="p-1"><input type="number" step="0.01" value="${data.peso||''}" placeholder="g" class="input w-full rounded px-2 py-1.5 text-xs"></td>
        <td class="p-1"><select class="input w-full rounded px-2 py-1.5 text-xs"><option></option><option${data.alim==='LM'?' selected':''}>LM</option><option${data.alim==='Fórmula'?' selected':''}>Fórmula</option><option${data.alim==='Mixta'?' selected':''}>Mixta</option><option${data.alim==='NPO'?' selected':''}>NPO</option></select></td>
        <td class="p-1"><input value="${data.diuresis||''}" class="input w-full rounded px-2 py-1.5 text-xs"></td>
        <td class="p-1"><input value="${data.depo||''}" class="input w-full rounded px-2 py-1.5 text-xs"></td>
        <td class="p-1"><input value="${data.exam||''}" class="input w-full rounded px-2 py-1.5 text-xs"></td>
        <td class="p-1"><input value="${data.plan||''}" class="input w-full rounded px-2 py-1.5 text-xs"></td>
        <td class="p-1 text-center"><button type="button" onclick="this.closest('tr').remove()" class="text-gray-600 hover:text-red-400">✕</button></td>
    `;
    $('seg-diario-body').appendChild(tr);
}
$('btn-add-dia').onclick = ()=>addDia();

// Actualización exámenes
