    const div = document.createElement('div'); div.className='grid grid-cols-12 gap-2 items-center';
    div.innerHTML = `
        <input type="date" value="${data.fecha||''}" class="col-span-2 input rounded-lg px-2 py-1.5 text-sm">
        <select class="col-span-2 input rounded-lg px-2 py-1.5 text-sm"><option></option>${['Bili','Hemograma','PCR','Hemocultivo','Rx','Eco','Otro'].map(o=>`<option${data.examen===o?' selected':''}>${o}</option>`).join('')}</select>
