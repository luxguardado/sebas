// Guardar
btnGuardar.onclick = async ()=>{
    const get = id => $(id)?.value || '';
    const data = {
        nombreRN: get('nombreRN'), expediente: get('expediente'), sexo: get('sexo'), fechaNac: get('fechaNac'), horaNac: get('horaNac'),
        peso: get('peso'), talla: get('talla'), pc: get('pc'), eg: get('eg'), apgar1: get('apgar1'), apgar5: get('apgar5'),
        nombreMadre: get('nombreMadre'), edadMadre: get('edadMadre'), g:get('g'), p:get('p'), c:get('c'), a:get('a'),
        tipoRhMadre: get('tipoRhMadre'), vih: get('vih'), rpr: get('rpr'), hbMadre: get('hbMadre'),
        partoTipo: get('partoTipo'), partoObs: get('partoObs'),
        sala: get('sala'), cama: get('cama'), direccion: get('direccion'), telefono: get('telefono'),
        rhRN: get('rhRN'), biliTotal: get('biliTotal'), biliDirecta: get('biliDirecta'), biliTrans: get('biliTrans'),
        glucometria: get('glucometria'), hbRN: get('hbRN'), htoRN: get('htoRN'),
        tamizPre: get('tamizPre'), tamizPost: get('tamizPost'), tamizResultado: $('tamizResultado').textContent,
        cie11: Array.from({length:10},(_,i)=>get('cie'+(i+1))).filter(Boolean),
        interconsultas: Array.from(document.querySelectorAll('.interconsulta-item')).map(el=>({especialidad: el.dataset.esp, nota: el.querySelector('textarea').value})),
        estudios: {rx:{fecha:get('rxFecha'),hallazgo:get('rxHallazgo')}, eco:{fecha:get('ecoFecha'),hallazgo:get('ecoHallazgo')}, usgTf:{fecha:get('usgTfFecha'),hallazgo:get('usgTfHallazgo')}, usgAb:{fecha:get('usgAbFecha'),hallazgo:get('usgAbHallazgo')}},
        seguimientoDiario: Array.from($('seg-diario-body').querySelectorAll('tr')).map(tr=>{const i=tr.querySelectorAll('input,select'); return {fecha:i[0].value,peso:i[1].value,alim:i[2].value,diuresis:i[3].value,depo:i[4].value,exam:i[5].value,plan:i[6].value}}),
        actualizacionExamenes: Array.from($('act-examenes-list').children).map(d=>{const i=d.querySelectorAll('input,select'); return {fecha:i[0].value,examen:i[1].value,res:i[2].value,conducta:i[3].value}}),
        egresoTipo: document.querySelector('input[name="egresoTipo"]:checked')?.value || '',
        egreso: {fechaAlta:get('fechaAlta'),pesoEgreso:get('pesoEgreso'),alimentacionEgreso:get('alimentacionEgreso'),citasControl:get('citasControl'),indicaciones:get('indicaciones'),fechaTraslado:get('fechaTraslado'),servicioDestino:get('servicioDestino'),motivoTraslado:get('motivoTraslado'),fechaFallecido:get('fechaFallecido'),horaFallecido:get('horaFallecido'),causaBasica:get('causaBasica'),causaDirecta:get('causaDirecta')}
    };

    try{
        await fetch(scriptURL, {method:'POST', mode:'no-cors', headers:{'Content-Type':'application/json'}, body: JSON.stringify(data)});
    }catch(e){ console.log('Offline save'); }

    // Guardar local
    const pacientes = JSON.parse(localStorage.getItem('sebasPacientes')||'[]');
    pacientes.unshift({...data, timestamp: new Date().toISOString()});
    localStorage.setItem('sebasPacientes', JSON.stringify(pacientes.slice(0,50)));
    updateResumen();

    alert('ya soy tu amiguito Sebastian!');
    
    // Limpiar
    $('form-sebas').reset();
    $('seg-diario-body').innerHTML=''; $('act-examenes-list').innerHTML=''; $('interconsultas-lista').innerHTML='';
    $('tamizResultado').innerHTML=''; document.querySelectorAll('.chip').forEach(c=>c.classList.remove('active'));
    $('egreso-alta').classList.add('hidden'); $('egreso-traslado').classList.add('hidden'); $('egreso-fallecido').classList.add('hidden');
    btnGuardar.className = 'px-8 py-3.5 rounded-2xl font-semibold bg-gray-700 text-gray-300'; btnGuardar.innerHTML='Guardar';
    window.scrollTo({top:0, behavior:'smooth'});
};

// Resumen
function updateResumen(){
    const tbody = $('resumen-body'); tbody.innerHTML='';
    const pacientes = JSON.parse(localStorage.getItem('sebasPacientes')||'[]');
    pacientes.slice(0,10).forEach(p=>{
        const tr = document.createElement('tr'); tr.className='hover:bg-[#111] cursor-pointer';
        tr.innerHTML = `<td class="p-2">${p.nombreRN||''}</td><td class="p-2 text-gray-400">${p.expediente||''}</td><td class="p-2">${p.sala||''}</td><td class="p-2">${p.cama||''}</td><td class="p-2 text-xs">${(p.cie11||[])[0]||''}</td><td class="p-2 text-gray-500">${p.fechaNac||''}</td>`;
        tr.onclick = ()=>populateForm(p);
        tbody.appendChild(tr);
    });
}

// Buscar y poblar
function populateForm(p){
    Object.keys(p).forEach(k=>{ const el=$(k); if(el) el.value=p[k]; });
    // CIE
    (p.cie11||[]).forEach((v,i)=>{ const el=$('cie'+(i+1)); if(el) el.value=v; });
    // Tamizaje
    $('tamizPre').value=p.tamizPre||''; $('tamizPost').value=p.tamizPost||''; calcularTamizaje();
    // Interconsultas
    $('interconsultas-lista').innerHTML=''; (p.interconsultas||[]).forEach(ic=>{ chipsCont.querySelector(`button`).click(); /*simplified*/ });
    // Estudios
    if(p.estudios){ $('rxFecha').value=p.estudios.rx?.fecha||''; $('rxHallazgo').value=p.estudios.rx?.hallazgo||''; $('ecoFecha').value=p.estudios.eco?.fecha||''; $('ecoHallazgo').value=p.estudios.eco?.hallazgo||''; $('usgTfFecha').value=p.estudios.usgTf?.fecha||''; $('usgTfHallazgo').value=p.estudios.usgTf?.hallazgo||''; $('usgAbFecha').value=p.estudios.usgAb?.fecha||''; $('usgAbHallazgo').value=p.estudios.usgAb?.hallazgo||''; }
    // Seguimiento
    $('seg-diario-body').innerHTML=''; (p.seguimientoDiario||[]).forEach(addDia);
    $('act-examenes-list').innerHTML=''; (p.actualizacionExamenes||[]).forEach(addExamen);
    // Egreso
    if(p.egresoTipo){ document.querySelector(`input[name="egresoTipo"][value="${p.egresoTipo}"]`)?.click(); Object.keys(p.egreso||{}).forEach(k=>{ const el=$(k); if(el) el.value=p.egreso[k]; }); }
    // Sexo button
    $('sexo').dispatchEvent(new Event('change'));
    window.scrollTo({top:0, behavior:'smooth'});
}

$('btn-buscar').onclick = ()=>{
    const q = $('input-busqueda').value.toLowerCase().trim(); if(!q) return;
    const pacientes = JSON.parse(localStorage.getItem('sebasPacientes')||'[]');
    const p = pacientes.find(pat => 
        (pat.nombreRN||'').toLowerCase().includes(q) ||
        (pat.expediente||'').toLowerCase().includes(q) ||
        (pat.sala||'').toLowerCase().includes(q) ||
        (pat.cama||'').toLowerCase().includes(q) ||
        (pat.cie11||[]).join(' ').toLowerCase().includes(q)
    );
    if(p) populateForm(p); else alert('Paciente no encontrado');
};
$('input-busqueda').addEventListener('keydown', e=>{ if(e.key==='Enter'){ e.preventDefault(); $('btn-buscar').click(); } });

// Email
$('btn-email').onclick = ()=>{
    const pacientes = JSON.parse(localStorage.getItem('sebasPacientes')||'[]').slice(0,5);
    const body = pacientes.map(p=>`${p.nombreRN} (${p.expediente}) - ${p.sala}/${p.cama} - ${(p.cie11||[])[0]||''}`).join('%0D%0A');
    window.location.href = `mailto:?subject=Resumen SEBAS v8.4&body=${body}`;
};

// Init
addDia(); addExamen(); updateResumen();
</script>
